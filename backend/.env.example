# Copy to .env. Never put real keys in frontend files.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=90
# json_object for compatible providers, json_schema when supported
MODEL_RESPONSE_FORMAT=json_object
MAX_ANALYSIS_CHARS=24000
# Optional: false bypasses system proxy variables (TLS verification stays on).
MODEL_TRUST_ENV=true
# DeepSeek optional settings: disabled / enabled. Leave empty for other providers.
MODEL_THINKING=
MODEL_MAX_TOKENS=
